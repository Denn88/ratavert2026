[Unit]
Description=RatAvert Pi Client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__PI_USER__
WorkingDirectory=__PI_HOME__/ratavert-pi
EnvironmentFile=__PI_HOME__/ratavert-pi/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -u __PI_HOME__/ratavert-pi/ratavert_client_example.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
