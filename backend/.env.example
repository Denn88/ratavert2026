PORT=4000

# Long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
DEVICE_KEY=change-me

# Supabase -> Connect -> Session pooler connection string (port 5432).
# If the database password has special characters (@ : / # ?), percent-encode them.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Set to false only for a local Postgres without TLS.
DATABASE_SSL=true

# Supabase -> Settings -> API Keys. Use the SECRET key (sb_secret_...). Backend only, never in the frontend.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxx
SUPABASE_BUCKET=photos

# First admin account, created only when the accounts table is empty.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=choose-a-strong-password

# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGIN=https://your-frontend.vercel.app

TRIGGER_COOLDOWN_SECONDS=10
DEVICE_OFFLINE_AFTER_SECONDS=20
