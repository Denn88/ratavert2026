# Copy this file to .env and fill in real values before starting the server.
# For local development, leave DATA_DIR unset — it defaults to this folder.
# On Railway/Render, set DATA_DIR to your mounted persistent volume path
# (e.g. /data) so the database and photos survive redeploys.
DATA_DIR=

# Port the backend listens on. Railway/Render set this automatically in
# production — you only need to set it for local development if 4000 is busy.
PORT=4000

# Long random string used to sign login sessions (JWTs). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# Shared secret the Raspberry Pi uses to authenticate to /api/pi/* routes.
# Generate one the same way as JWT_SECRET. The install script on the Pi
# will ask you to paste this value in.
DEVICE_KEY=change_this_to_a_long_random_string

# Seed admin account — only used the FIRST time the server starts (when the
# accounts table is empty). Change the password immediately after first login.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change_me_immediately

# Comma-separated list of origins allowed to call this API (your dashboard's
# URL). For local dev: http://localhost:5173
# For production once deployed to Vercel: https://your-app.vercel.app
# You can list multiple, comma-separated, while testing both at once.
CORS_ORIGIN=http://localhost:5173

# Minimum seconds between manual test-fires of the same trigger type,
# per requesting user — protects the physical hardware from being hammered.
TRIGGER_COOLDOWN_SECONDS=10

# Seconds of silence after which the Pi is considered offline
DEVICE_OFFLINE_AFTER_SECONDS=20
