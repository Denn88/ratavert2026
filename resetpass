/**
 * reset-admin-password.js
 *
 * One-off utility to reset (or recreate) the admin account's password
 * directly in the ratavert SQLite database. Safe to run multiple times.
 *
 * USAGE
 * -----
 * From the root of your ratavert-backend project (where package.json,
 * better-sqlite3, and bcryptjs are already installed as dependencies):
 *
 *   node reset-admin-password.js <username> <new-password>
 *
 * Example:
 *   node reset-admin-password.js admin MyNewStrongPassword123!
 *
 * On Render: open the Shell tab for your service and run the command
 * there, pointing DATA_DIR at the same disk your app uses (it already
 * will be, since env vars carry over into the shell).
 *
 * On Railway: use `railway run node reset-admin-password.js admin ...`
 * or open a shell from the dashboard.
 *
 * WHAT IT DOES
 * ------------
 * - Opens the same DB file your app uses (respects DATA_DIR env var,
 *   exactly like db.js does).
 * - If the given username exists, updates its password_hash in place.
 * - If it does NOT exist, creates it fresh with role='admin', active=1.
 * - Prints a confirmation. Does not touch any other tables.
 *
 * Delete this file (or at least stop leaving it in your deployed repo)
 * once you're done — a password-reset script sitting in a public repo
 * is a standing risk if the route to run it is ever exposed over HTTP.
 */

const path = require("path");
const fs = require("fs");
const Database = require("better-sqlite3");
const bcrypt = require("bcryptjs");

const [, , usernameArg, passwordArg] = process.argv;

if (!usernameArg || !passwordArg) {
  console.error("Usage: node reset-admin-password.js <username> <new-password>");
  process.exit(1);
}

if (passwordArg.length < 8) {
  console.error("Refusing to set a password shorter than 8 characters. Pick something stronger.");
  process.exit(1);
}

const username = usernameArg.toLowerCase();

const DATA_DIR = process.env.DATA_DIR || __dirname;
const dbPath = path.join(DATA_DIR, "ratavert.db");

if (!fs.existsSync(dbPath)) {
  console.error(`No database found at ${dbPath}. Check that DATA_DIR is set correctly (currently: ${DATA_DIR}).`);
  process.exit(1);
}

const db = new Database(dbPath);

const hash = bcrypt.hashSync(passwordArg, 10);
const existing = db.prepare("SELECT username FROM accounts WHERE username = ?").get(username);

if (existing) {
  db.prepare("UPDATE accounts SET password_hash = ?, active = 1 WHERE username = ?").run(hash, username);
  console.log(`Updated password for existing account "${username}".`);
} else {
  db.prepare(
    `INSERT INTO accounts (username, password_hash, role, active, created_at) VALUES (?, ?, 'admin', 1, ?)`
  ).run(username, hash, new Date().toISOString());
  console.log(`Account "${username}" did not exist — created it fresh with role 'admin'.`);
}

db.close();
console.log("Done. You should be able to log in now.");
